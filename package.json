{
  "name": "dining-plus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "dev:e2e": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "supabase": "supabase",
    "db:migration:new": "supabase migration new",
    "db:migrations": "supabase migration list --linked",
    "db:lint": "supabase db lint --linked --level warning",
    "db:push:dry-run": "supabase db push --linked --dry-run",
    "db:push": "supabase db push --linked",
    "db:types": "supabase gen types typescript --linked --schema public > src/types/database.ts",
    "demo:seed": "node scripts/seed-demo.mjs",
    "audit": "npm audit --omit=dev --audit-level=high",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run audit"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.12.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.1",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "jsdom": "27.4.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  }
}
